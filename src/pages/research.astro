---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const topicsUrl = getRelativeLocaleUrl(locale, "topics");
---

<Layout title="主题已迁移 | jpf-hash 的笔记本">
  <meta slot="head" http-equiv="refresh" content={`0; url=${topicsUrl}`} />
  <main class="app-layout py-20">
    <p class="text-muted-foreground text-sm">
      页面已迁移至 <a class="text-foreground underline" href={topicsUrl}>主题</a>。
    </p>
  </main>
</Layout>
