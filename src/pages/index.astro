---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const totalTags = new Set(sortedPosts.flatMap(({ data }) => data.tags)).size;
const totalCategories = new Set(sortedPosts.map(({ data }) => data.category))
  .size;

const focusAreas = [
  ["01", "Machine Learning", "经典算法、评估方法、实验复盘。"],
  ["02", "Graph Learning", "GNN、OOD 检测、图推荐方向。"],
  ["03", "Python Systems", "数据处理、自动化、可复用代码。"],
];

const stats = [
  { label: "Articles", value: sortedPosts.length },
  { label: "Tags", value: totalTags },
  { label: "Sections", value: totalCategories },
];

const routes = [
  {
    eyebrow: "Roadmap",
    title: "学习路线",
    desc: "把 Python、机器学习和图神经网络拆成可推进的阶段。",
    href: getRelativeLocaleUrl(locale, "roadmap"),
  },
  {
    eyebrow: "Archive",
    title: "文章归档",
    desc: "按时间、标签和分类找回长期积累的笔记。",
    href: getRelativeLocaleUrl(locale, "archives"),
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      class="border-border grid gap-10 border-b py-16 md:grid-cols-[1.25fr_0.75fr] md:py-24"
    >
      <div>
        <p
          class="text-accent text-xs font-semibold tracking-[0.24em] uppercase"
        >
          Research Notes / AI / Python
        </p>
        <h1
          class="mt-5 max-w-3xl text-5xl leading-[0.95] font-semibold tracking-[-0.04em] sm:text-7xl"
        >
          jpf-hash 的技术笔记。
        </h1>
        <p class="text-muted-foreground mt-7 max-w-2xl text-lg leading-8">
          一个克制、可检索、持续生长的学习记录。主要写
          Python、机器学习、图神经网络，以及实验过程中的判断、失败和复盘。
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="bg-foreground text-background hover:bg-accent hover:text-accent-foreground rounded-none px-5 py-3 text-sm font-semibold transition-colors"
          >
            进入文章
            <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
          </LinkButton>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "roadmap")}
            class="border-border hover:border-accent rounded-none border px-5 py-3 text-sm font-semibold transition-colors"
          >
            查看路线
          </LinkButton>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="border-border hover:border-accent inline-flex size-11 items-center justify-center border transition-colors"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss class="text-accent size-5 stroke-3 rtl:-rotate-90" />
            <span class="sr-only">RSS Feed</span>
          </a>
        </div>
      </div>

      <aside
        class="border-border grid content-between border-t pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-8"
      >
        <div>
          <p class="text-muted-foreground text-sm leading-7">
            不是作品集，也不是教程仓库。这里更像一份实验室手册：记录为什么这样做、哪里失败、下一次怎么改。
          </p>
        </div>
        <dl
          class="border-border bg-border mt-10 grid grid-cols-3 gap-px border"
        >
          {
            stats.map(stat => (
              <div class="bg-background p-4">
                <dt class="text-muted-foreground text-xs tracking-wider uppercase">
                  {stat.label}
                </dt>
                <dd class="mt-2 text-2xl font-semibold tracking-tight">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </section>

    <section
      class="border-border bg-border grid gap-px border-b md:grid-cols-3"
    >
      {
        focusAreas.map(([number, title, desc]) => (
          <article class="bg-background py-8 md:px-6 first:md:pl-0 last:md:pr-0">
            <span class="text-accent text-xs font-semibold tracking-widest">
              {number}
            </span>
            <h2 class="mt-4 text-xl font-semibold tracking-tight">{title}</h2>
            <p class="text-muted-foreground mt-3 text-sm leading-7">{desc}</p>
          </article>
        ))
      }
    </section>

    <section
      class="border-border grid gap-10 border-b py-12 md:grid-cols-[0.7fr_1.3fr]"
    >
      <div>
        <p
          class="text-accent text-xs font-semibold tracking-[0.24em] uppercase"
        >
          Navigation
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em]">
          从路径开始，而不是从文章列表开始。
        </h2>
      </div>
      <div class="border-border bg-border grid gap-px border sm:grid-cols-2">
        {
          routes.map(route => (
            <a
              href={route.href}
              class="group bg-background hover:bg-card p-6 transition-colors"
            >
              <span class="text-muted-foreground text-xs font-semibold tracking-widest uppercase">
                {route.eyebrow}
              </span>
              <h3 class="group-hover:text-accent mt-5 text-xl font-semibold">
                {route.title}
              </h3>
              <p class="text-muted-foreground mt-3 text-sm leading-7">
                {route.desc}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-border border-b py-12">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.24em] uppercase">
                Featured
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-[-0.03em]">
                {t.home.featured}
              </h2>
            </div>
          </div>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="py-12">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.24em] uppercase">
                Latest
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-[-0.03em]">
                {t.home.recentPosts}
              </h2>
            </div>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="text-muted-foreground hover:text-accent hidden text-sm font-semibold sm:inline-flex"
            >
              {t.home.allPosts}
              <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
