---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const totalTags = new Set(sortedPosts.flatMap(({ data }) => data.tags)).size;
const totalCategories = new Set(sortedPosts.map(({ data }) => data.category))
  .size;

const focusAreas = [
  ["Machine Learning", "经典机器学习算法、评估方法、实验复盘与可解释记录。"],
  ["Graph Learning", "图神经网络、图表示学习、OOD 检测与图推荐方向。"],
  ["Python Data Systems", "面向实验的 Python 数据处理、自动化与可复现流程。"],
];

const stats = [
  { label: "Notes", value: sortedPosts.length },
  { label: "Tags", value: totalTags },
  { label: "Areas", value: totalCategories },
];

const news = [
  {
    date: "2026.06",
    text: "Redesigned the site as a research-note homepage with a quieter academic layout.",
  },
  {
    date: "2026.06",
    text: "Started organizing notes around Python, machine learning, and graph learning.",
  },
  {
    date: "2026.06",
    text: "Added writing templates for technical notes, project reviews, debugging notes, and paper reading.",
  },
];

const quickLinks = [
  {
    title: "Research",
    desc: "当前关注的研究与实验方向。",
    href: getRelativeLocaleUrl(locale, "research"),
  },
  {
    title: "Notes",
    desc: "技术笔记、论文阅读和踩坑记录。",
    href: getRelativeLocaleUrl(locale, "posts"),
  },
  {
    title: "Roadmap",
    desc: "从基础工具到图学习的学习路径。",
    href: getRelativeLocaleUrl(locale, "roadmap"),
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      class="border-border grid gap-12 border-b py-16 md:grid-cols-[0.62fr_0.38fr] md:py-24"
    >
      <div>
        <p
          class="text-accent text-xs font-semibold tracking-[0.24em] uppercase"
        >
          Personal Research Notes
        </p>
        <h1
          class="mt-5 max-w-3xl text-5xl leading-[0.98] font-semibold tracking-[-0.04em] sm:text-7xl"
        >
          jpf-hash
        </h1>
        <p class="text-muted-foreground mt-7 max-w-2xl text-lg leading-8">
          I keep notes on Python, machine learning, graph learning, and the
          experiments behind them. This site is a compact research notebook:
          concepts, implementations, failed attempts, and follow-up plans.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "research")}
            class="bg-foreground text-background hover:bg-accent hover:text-accent-foreground rounded-none px-5 py-3 text-sm font-semibold transition-colors"
          >
            Research interests
            <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
          </LinkButton>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="border-border hover:border-accent rounded-none border px-5 py-3 text-sm font-semibold transition-colors"
          >
            Browse notes
          </LinkButton>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="border-border hover:border-accent inline-flex size-11 items-center justify-center border transition-colors"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss class="text-accent size-5 stroke-3 rtl:-rotate-90" />
            <span class="sr-only">RSS Feed</span>
          </a>
        </div>
      </div>

      <aside
        class="border-border grid content-between border-t pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-8"
      >
        <div>
          <h2 class="text-sm font-semibold tracking-[0.18em] uppercase">
            Focus
          </h2>
          <p class="text-muted-foreground mt-4 text-sm leading-7">
            Machine learning foundations, graph neural networks, OOD detection,
            recommendation systems, and Python data workflows.
          </p>
        </div>
        <dl
          class="border-border bg-border mt-10 grid grid-cols-3 gap-px border"
        >
          {
            stats.map(stat => (
              <div class="bg-background p-4">
                <dt class="text-muted-foreground text-xs tracking-wider uppercase">
                  {stat.label}
                </dt>
                <dd class="mt-2 text-2xl font-semibold tracking-tight">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </section>

    <section
      class="border-border grid gap-10 border-b py-12 md:grid-cols-[0.32fr_0.68fr]"
    >
      <div>
        <p
          class="text-accent text-xs font-semibold tracking-[0.24em] uppercase"
        >
          Research interests
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em]">
          Topics I am currently organizing.
        </h2>
      </div>
      <div class="divide-border divide-y">
        {
          focusAreas.map(([title, desc]) => (
            <article class="grid gap-3 py-5 sm:grid-cols-[12rem_1fr]">
              <h3 class="font-semibold tracking-tight">{title}</h3>
              <p class="text-muted-foreground text-sm leading-7">{desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="border-border grid gap-10 border-b py-12 md:grid-cols-[0.7fr_1.3fr]"
    >
      <div>
        <p
          class="text-accent text-xs font-semibold tracking-[0.24em] uppercase"
        >
          News
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em]">
          Recent updates.
        </h2>
      </div>
      <ol class="divide-border divide-y">
        {
          news.map(item => (
            <li class="grid gap-3 py-4 sm:grid-cols-[7rem_1fr]">
              <time class="text-accent text-sm font-semibold">{item.date}</time>
              <p class="text-muted-foreground text-sm leading-7">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="border-border bg-border grid gap-px border-b md:grid-cols-3"
    >
      {
        quickLinks.map(link => (
          <a
            href={link.href}
            class="group bg-background hover:bg-card p-6 transition-colors"
          >
            <h2 class="group-hover:text-accent text-xl font-semibold tracking-tight">
              {link.title}
            </h2>
            <p class="text-muted-foreground mt-3 text-sm leading-7">
              {link.desc}
            </p>
          </a>
        ))
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-border border-b py-12">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.24em] uppercase">
                Featured
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-[-0.03em]">
                {t.home.featured}
              </h2>
            </div>
          </div>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="py-12">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.24em] uppercase">
                Latest
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-[-0.03em]">
                {t.home.recentPosts}
              </h2>
            </div>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="text-muted-foreground hover:text-accent hidden text-sm font-semibold sm:inline-flex"
            >
              {t.home.allPosts}
              <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
