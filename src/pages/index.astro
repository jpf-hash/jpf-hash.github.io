---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="relative py-12 overflow-hidden">
      <!-- Gradient background -->
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-accent/5 via-transparent to-transparent"></div>
      <div class="absolute top-0 right-0 -z-10 w-96 h-96 bg-accent/10 rounded-full blur-3xl"></div>

      <h1 class="my-4 inline-block text-4xl font-extrabold tracking-tight sm:my-6 sm:text-5xl lg:text-6xl">
        你好，我是
        <span class="bg-gradient-to-r from-accent to-cyan-400 bg-clip-text text-transparent">
          jpf-hash
        </span>
        👋
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block ml-2"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90 hover:scale-150 transition-transform"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
        这里是我的技术博客，专注于
        <span class="text-foreground font-medium">机器学习</span>、
        <span class="text-foreground font-medium">Python 编程</span> 和
        <span class="text-foreground font-medium">数据科学</span> 领域。
        我在这里记录学习笔记、分享技术见解、探索数据的奥秘。
      </p>
      <p class="mt-4 text-muted-foreground">
        欢迎阅读我的文章，或在
        <LinkButton
          class="text-accent hover:text-accent/80 underline decoration-wavy underline-offset-4 font-medium"
          href="https://github.com/jpf-hash"
        >
          GitHub
        </LinkButton> 上找到我。
      </p>
      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center gap-2">
            <div class="text-muted-foreground text-sm font-medium">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-8 pb-6">
          <h2 class="text-2xl font-bold tracking-tight mb-4 flex items-center gap-2">
            <span class="inline-block w-1.5 h-6 bg-accent rounded-full"></span>
            {t.home.featured}
          </h2>
          <ul class="stagger">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-8 pb-6">
          <h2 class="text-2xl font-bold tracking-tight mb-4 flex items-center gap-2">
            <span class="inline-block w-1.5 h-6 bg-accent rounded-full"></span>
            {t.home.recentPosts}
          </h2>
          <ul class="stagger">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent/10 text-accent hover:bg-accent hover:text-accent-foreground transition-all duration-300 font-medium"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
