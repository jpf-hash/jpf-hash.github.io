---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const sortedPosts = getSortedPosts(await getCollection("posts"));
const projectPosts = sortedPosts.filter(({ data }) => data.category === "项目");
const writingPosts = sortedPosts.filter(({ data }) => data.category !== "项目");
const homePath = getRelativeLocaleUrl(locale, "");

const sections = [
  {
    id: "programming",
    no: "01",
    title: "编程与工具",
    desc: "代码、环境、命令行和可以反复使用的工作流。",
  },
  {
    id: "data-ml",
    no: "02",
    title: "数据与机器学习",
    desc: "数据处理、模型评估、实验过程与结果。",
  },
  {
    id: "projects",
    no: "03",
    title: "项目与实践",
    desc: "从问题到实现，再到项目完成后的复盘。",
  },
  {
    id: "reading",
    no: "04",
    title: "阅读笔记",
    desc: "书籍、课程、技术文章和论文中的理解。",
  },
];

const quickLinks = [
  ...(projectPosts.length > 0
    ? [{ label: "作品", href: getRelativeLocaleUrl(locale, "works") }]
    : []),
  { label: "笔记", href: getRelativeLocaleUrl(locale, "posts") },
  { label: "主题", href: getRelativeLocaleUrl(locale, "topics") },
  { label: "关于", href: getRelativeLocaleUrl(locale, "about") },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" data-home-path={homePath}>
    <section class="relative min-h-[34rem] overflow-hidden border-b border-black/20 text-[#111310] sm:min-h-[38rem]">
      <img
        src={`${import.meta.env.BASE_URL}assets/archive-desk.png`}
        alt="打开的方格笔记本、绘图纸与机械铅笔"
        class="absolute inset-0 size-full object-cover object-center"
        width="1716"
        height="918"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-white/48"></div>

      <div class="app-layout relative flex min-h-[34rem] flex-col justify-between py-8 sm:min-h-[38rem] sm:py-10">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-black/25 pb-4 text-[11px] font-semibold uppercase">
          <span>Personal archive / 2026</span>
          <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="首页快捷导航">
            {quickLinks.map(link => <a class="hover:text-[#e13b27]" href={link.href}>{link.label}</a>)}
          </nav>
        </div>

        <div class="max-w-5xl pb-4">
          <p class="mb-4 text-sm font-bold text-[#e13b27]">NOTES · WORK · PROCESS</p>
          <h1 class="font-display text-6xl leading-[0.9] font-semibold sm:text-8xl lg:text-[9rem]">
            jpf—hash
          </h1>
          <div class="mt-7 grid max-w-4xl gap-6 md:grid-cols-[1fr_auto] md:items-end">
            <p class="max-w-2xl text-base leading-7 font-medium sm:text-lg sm:leading-8">
              项目、学习、阅读和解决问题的记录。这里保存结果，也保留抵达结果之前的过程。
            </p>
            <div class="flex flex-wrap gap-2">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "posts")}
                class="bg-[#111310] px-5 py-3 text-sm font-semibold text-white hover:bg-[#e13b27]"
              >
                开始阅读
                <IconArrowRight class="size-4" />
              </LinkButton>
              <LinkButton
                href={getRelativeLocaleUrl(locale, "about")}
                class="border border-black/40 bg-white/35 px-5 py-3 text-sm font-semibold hover:border-[#e13b27]"
              >
                关于
              </LinkButton>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="app-layout">
      {
        projectPosts.length > 0 && (
          <section class="grid gap-8 border-b py-14 lg:grid-cols-[16rem_1fr] lg:py-20">
            <header>
              <p class="text-accent text-xs font-bold uppercase">Selected work</p>
              <h2 class="font-display mt-3 text-4xl font-semibold">作品</h2>
            </header>
            <div>
              <ul class="border-border border-t">
                {projectPosts.slice(0, 3).map(post => <Card variant="h3" {...post} />)}
              </ul>
              <a class="text-accent mt-6 inline-flex items-center gap-2 text-sm font-semibold" href={getRelativeLocaleUrl(locale, "works")}>
                查看全部 <IconArrowRight class="size-4" />
              </a>
            </div>
          </section>
        )
      }

      <section class="grid gap-8 border-b py-14 lg:grid-cols-[16rem_1fr] lg:py-20">
        <header>
          <p class="text-accent text-xs font-bold uppercase">Content index</p>
          <h2 class="font-display mt-3 text-4xl font-semibold">内容索引</h2>
        </header>
        <ol class="border-border border-t">
          {
            sections.map(section => (
              <li class="border-border border-b">
                <a
                  href={`${getRelativeLocaleUrl(locale, "topics")}#${section.id}`}
                  class="group grid gap-3 py-5 sm:grid-cols-[3rem_13rem_1fr_auto] sm:items-center"
                >
                  <span class="text-accent text-xs font-bold">{section.no}</span>
                  <span class="text-xl font-semibold">{section.title}</span>
                  <span class="text-muted-foreground text-sm leading-6">{section.desc}</span>
                  <IconArrowRight class="text-muted-foreground group-hover:text-accent hidden size-5 sm:block" />
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      {
        writingPosts.length > 0 && (
          <section id="recent-posts" class="grid gap-8 py-14 lg:grid-cols-[16rem_1fr] lg:py-20">
            <header>
              <p class="text-accent text-xs font-bold uppercase">Latest notes</p>
              <h2 class="font-display mt-3 text-4xl font-semibold">最近更新</h2>
            </header>
            <div>
              <ul class="border-border border-t">
                {writingPosts.slice(0, config.posts.perIndex).map(post => <Card variant="h3" {...post} />)}
              </ul>
              <a class="text-accent mt-6 inline-flex items-center gap-2 text-sm font-semibold" href={getRelativeLocaleUrl(locale, "posts")}>
                全部笔记 <IconArrowRight class="size-4" />
              </a>
            </div>
          </section>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
