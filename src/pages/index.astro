---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const focusAreas = [
  {
    title: "机器学习",
    desc: "整理算法原理、实验记录和模型调参经验。",
  },
  {
    title: "图神经网络",
    desc: "记录 GNN、OOD 检测和图表示学习相关探索。",
  },
  {
    title: "Python 工程",
    desc: "沉淀数据处理、自动化和可复用代码实践。",
  },
];

const stack = ["Python", "PyTorch", "Pandas", "NumPy", "GNN", "Astro"];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="relative overflow-hidden py-14 sm:py-18">
      <div class="absolute inset-0 -z-10 rounded-3xl border border-card-border bg-card/70 shadow-xl shadow-accent/5"></div>
      <div class="absolute -top-24 right-0 -z-10 size-72 rounded-full bg-accent/15 blur-3xl"></div>
      <div class="absolute -bottom-28 left-8 -z-10 size-72 rounded-full bg-cyan-400/10 blur-3xl"></div>

      <div class="px-5 sm:px-8">
        <p class="mb-4 inline-flex rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-sm font-medium text-accent">
          AI 学习记录 / Python 实践 / 图机器学习
        </p>

        <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
          把机器学习、图神经网络和工程实践，写成可复用的笔记。
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          我是 jpf-hash。这里记录 Python、机器学习、数据科学和图神经网络相关的学习路线、实验复盘与踩坑经验。
          目标不是堆文章，而是把每次学习变成能回头查、能继续长出来的知识资产。
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="rounded-full bg-accent px-5 py-2.5 font-semibold text-accent-foreground shadow-lg shadow-accent/20 transition-transform hover:-translate-y-0.5"
          >
            阅读文章
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "projects")}
            class="rounded-full border border-card-border bg-background/70 px-5 py-2.5 font-semibold hover:border-accent/50"
          >
            查看项目
          </LinkButton>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "roadmap")}
            class="rounded-full border border-card-border bg-background/70 px-5 py-2.5 font-semibold hover:border-accent/50"
          >
            学习路线
          </LinkButton>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="inline-flex size-11 items-center justify-center rounded-full border border-card-border bg-background/70 hover:border-accent/50"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss class="stroke-accent size-5 stroke-3 rtl:-rotate-90" />
            <span class="sr-only">RSS Feed</span>
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-2">
          {stack.map(item => (
            <li class="rounded-full border border-card-border bg-background/60 px-3 py-1 text-sm text-muted-foreground">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="grid gap-4 py-8 sm:grid-cols-3">
      {focusAreas.map(area => (
        <article class="rounded-xl border border-card-border bg-card p-5">
          <h2 class="text-lg font-bold">{area.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            {area.desc}
          </p>
        </article>
      ))}
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-8 pb-6">
          <h2 class="text-2xl font-bold tracking-tight mb-4 flex items-center gap-2">
            <span class="inline-block w-1.5 h-6 bg-accent rounded-full"></span>
            {t.home.featured}
          </h2>
          <ul class="stagger">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-8 pb-6">
          <h2 class="text-2xl font-bold tracking-tight mb-4 flex items-center gap-2">
            <span class="inline-block w-1.5 h-6 bg-accent rounded-full"></span>
            {t.home.recentPosts}
          </h2>
          <ul class="stagger">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent/10 text-accent hover:bg-accent hover:text-accent-foreground transition-all duration-300 font-medium"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
