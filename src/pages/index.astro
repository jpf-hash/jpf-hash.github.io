---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const projectPosts = sortedPosts.filter(({ data }) => data.category === "项目");
const featuredPosts = sortedPosts.filter(
  ({ data }) => data.featured && data.category !== "项目"
);
const recentPosts = sortedPosts.filter(
  ({ data }) => data.category !== "项目" && !data.featured
);
const homePath = getRelativeLocaleUrl(locale, "");

const focusAreas = [
  {
    id: "programming",
    title: "编程与工具",
    desc: "Python、Git、命令行、开发工具，以及能反复用起来的工作流。",
  },
  {
    id: "data-ml",
    title: "数据与机器学习",
    desc: "数据处理、机器学习基础、模型评估和实验记录。",
  },
  {
    id: "projects",
    title: "项目与实践",
    desc: "课程作业、小项目、踩坑过程、部署记录和项目复盘。",
  },
  {
    id: "reading",
    title: "阅读笔记",
    desc: "技术文章、书籍、课程和论文阅读中真正理解下来的部分。",
  },
];

const indexLinks = [
  ...(projectPosts.length > 0
    ? [{ label: "作品", href: getRelativeLocaleUrl(locale, "works") }]
    : []),
  { label: "笔记", href: getRelativeLocaleUrl(locale, "posts") },
  { label: "主题", href: getRelativeLocaleUrl(locale, "topics") },
  { label: "关于", href: getRelativeLocaleUrl(locale, "about") },
];

---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      class="border-border grid gap-12 border-b py-16 md:grid-cols-[0.62fr_0.38fr] md:py-24"
    >
      <div>
        <p
          class="text-accent text-xs font-semibold tracking-[0.24em] uppercase"
        >
          Personal archive
        </p>
        <h1
          class="mt-5 max-w-3xl text-5xl leading-[0.98] font-semibold tracking-[-0.04em] sm:text-7xl"
        >
          jpf-hash
        </h1>
        <p class="text-muted-foreground mt-7 max-w-2xl text-lg leading-8">
          这里收录我做过的项目、解决过的问题，以及在学习和阅读过程中留下的笔记。
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="bg-foreground text-background hover:bg-accent hover:text-accent-foreground rounded-none px-5 py-3 text-sm font-semibold transition-colors"
          >
            浏览笔记
            <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
          </LinkButton>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "about")}
            class="border-border hover:border-accent rounded-none border px-5 py-3 text-sm font-semibold transition-colors"
          >
            关于我
          </LinkButton>
        </div>
      </div>

      <aside
        class="border-border grid content-between border-t pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-8"
      >
        <div>
          <h2 class="text-sm font-semibold tracking-[0.18em] uppercase">
            Index
          </h2>
          <p class="text-muted-foreground mt-4 text-sm leading-7">
            项目、技术记录、阅读笔记和随笔，都在这里持续归档。
          </p>
        </div>
        <nav class="divide-border border-border mt-10 divide-y border-y">
          {
            indexLinks.map((link, index) => (
              <a
                href={link.href}
                class="group grid grid-cols-[2.5rem_1fr_auto] items-center gap-3 py-3 text-sm"
              >
                <span class="text-accent text-xs font-semibold">
                  {(index + 1).toString().padStart(2, "0")}
                </span>
                <span class="font-medium">{link.label}</span>
                <IconArrowRight class="text-muted-foreground group-hover:text-accent size-4 transition-colors" />
              </a>
            ))
          }
        </nav>
      </aside>
    </section>

    {
      projectPosts.length > 0 && (
        <section class="border-border border-b py-12">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.24em] uppercase">
                Selected work
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-[-0.03em]">
                作品与项目
              </h2>
            </div>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "works")}
              class="text-muted-foreground hover:text-accent hidden text-sm font-semibold sm:inline-flex"
            >
              查看全部
              <IconArrowRight class="inline-block size-4" />
            </LinkButton>
          </div>
          <ul>
            {projectPosts.slice(0, 3).map(data => <Card variant="h3" {...data} />)}
          </ul>
        </section>
      )
    }

    <section
      class="border-border grid gap-10 border-b py-12 md:grid-cols-[0.32fr_0.68fr]"
    >
      <div>
        <p
          class="text-accent text-xs font-semibold tracking-[0.24em] uppercase"
        >
          Content index
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em]">
          可以长期写下去的内容。
        </h2>
      </div>
      <div class="divide-border divide-y">
        {
          focusAreas.map(({ id, title, desc }) => (
            <article class="grid gap-3 py-5 sm:grid-cols-[12rem_1fr]">
              <h3 class="font-semibold tracking-tight">
                <a class="hover:text-accent transition-colors" href={`${getRelativeLocaleUrl(locale, "topics")}#${id}`}>
                  {title}
                </a>
              </h3>
              <p class="text-muted-foreground text-sm leading-7">{desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-border border-b py-12">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.24em] uppercase">
                Selected writing
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-[-0.03em]">
                {t.home.featured}
              </h2>
            </div>
          </div>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="py-12">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.24em] uppercase">
                Latest notes
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-[-0.03em]">
                {t.home.recentPosts}
              </h2>
            </div>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="text-muted-foreground hover:text-accent hidden text-sm font-semibold sm:inline-flex"
            >
              {t.home.allPosts}
              <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
