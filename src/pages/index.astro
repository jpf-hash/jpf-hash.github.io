---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const sortedPosts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);
const homePath = getRelativeLocaleUrl(locale, "");

const topics = [
  {
    id: "programming",
    title: "编程与工具",
    description: "Python、Git、命令行与日常开发工作流",
    hue: "from-violet-500/15 to-violet-500/0",
  },
  {
    id: "data-ml",
    title: "数据与机器学习",
    description: "数据处理、模型评估与实验方法",
    hue: "from-cyan-500/15 to-cyan-500/0",
  },
  {
    id: "projects",
    title: "项目与实践",
    description: "从问题、实现到结果的完整复盘",
    hue: "from-amber-500/15 to-amber-500/0",
  },
  {
    id: "reading",
    title: "阅读笔记",
    description: "课程、书籍、技术文章与论文",
    hue: "from-rose-500/15 to-rose-500/0",
  },
].map(topic => ({
  ...topic,
  count: sortedPosts.filter(post => post.data.topic === topic.id).length,
}));
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="app-layout"
    data-layout="index"
    data-home-path={homePath}
  >
    <section class="mx-auto max-w-3xl pt-20 pb-14 sm:pt-28 sm:pb-20">
      <div class="stagger">
        <div class="mb-8 flex items-center gap-4">
          <div
            class="border-border bg-card relative flex size-16 items-center justify-center rounded-2xl border shadow-sm"
          >
            <span
              class="bg-foreground text-background flex size-11 items-center justify-center rounded-xl font-mono text-sm font-semibold"
              >JH</span
            >
            <span
              class="border-background absolute -right-1 -bottom-1 size-4 rounded-full border-[3px] bg-emerald-500"
              aria-label="持续更新中"></span>
          </div>
          <div>
            <p class="font-semibold">jpf-hash</p>
            <p class="text-muted-foreground mt-0.5 text-sm">
              学习者 · 记录者 · 构建者
            </p>
          </div>
        </div>

        <h1
          class="font-display max-w-3xl text-5xl leading-[1.08] font-semibold tracking-[-0.055em] text-balance sm:text-7xl"
        >
          你好，我在这里记录<br class="hidden sm:block" />学习与构建的过程。
        </h1>

        <div
          class="text-muted-foreground mt-8 max-w-2xl space-y-4 text-base leading-8 sm:text-lg"
        >
          <p>
            我在学习编程、数据和机器学习。这个网站用来保存真正解决过的问题、做过的实验，以及值得再次使用的方法。
          </p>
          <p>
            文章不追求数量，更关心一件事：下一次遇到相似问题时，它是否依然有用。
          </p>
        </div>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="bg-foreground text-background hover:bg-accent inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-medium transition-all hover:-translate-y-0.5"
          >
            阅读笔记
            <IconArrowRight class="size-4" />
          </a>
          <a
            href="https://github.com/jpf-hash"
            class="border-border bg-card hover:bg-muted inline-flex items-center gap-2 rounded-xl border px-4 py-2.5 text-sm font-medium shadow-sm transition-all hover:-translate-y-0.5"
          >
            GitHub
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl py-10 sm:py-14">
      <div
        class="border-border bg-card/75 rounded-2xl border p-5 shadow-sm backdrop-blur sm:p-6"
      >
        <div class="flex items-center gap-2 text-sm font-medium">
          <span class="bg-accent size-2 rounded-full"></span>
          现在
        </div>
        <p class="text-muted-foreground mt-3 leading-7">
          正在把零散的学习记录整理成可以检索、持续更新、真正能复用的个人知识库。
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-3xl py-12 sm:py-16">
      <div class="mb-7 flex items-end justify-between gap-6">
        <div>
          <p class="text-muted-foreground text-sm">Writing</p>
          <h2
            class="font-display mt-1 text-2xl font-semibold tracking-[-0.03em]"
          >
            最近写作
          </h2>
        </div>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="text-muted-foreground hover:text-accent inline-flex items-center gap-1 text-sm transition-colors"
        >
          全部文章 <IconArrowRight class="size-4" />
        </a>
      </div>

      {
        sortedPosts.length > 0 ? (
          <ul class="space-y-2">
            {sortedPosts.slice(0, 5).map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground text-sm">第一篇文章正在路上。</p>
        )
      }
    </section>

    <section class="mx-auto max-w-3xl py-12 sm:py-16">
      <div class="mb-7">
        <p class="text-muted-foreground text-sm">Explore</p>
        <h2 class="font-display mt-1 text-2xl font-semibold tracking-[-0.03em]">
          沿着主题阅读
        </h2>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        {
          topics.map((topic, index) => (
            <a
              href={`${getRelativeLocaleUrl(locale, "topics")}#${topic.id}`}
              class="border-border bg-card group relative min-h-40 overflow-hidden rounded-2xl border p-5 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md"
            >
              <div
                class:list={[
                  "absolute inset-0 bg-gradient-to-br opacity-70",
                  topic.hue,
                ]}
                aria-hidden="true"
              />
              <div class="relative flex h-full flex-col justify-between">
                <div class="flex items-start justify-between">
                  <span class="text-muted-foreground font-mono text-xs">
                    0{index + 1}
                  </span>
                  <span class="text-muted-foreground group-hover:text-accent transition-transform group-hover:translate-x-0.5">
                    →
                  </span>
                </div>
                <div class="mt-10">
                  <h3 class="font-display text-lg font-semibold">
                    {topic.title}
                  </h3>
                  <p class="text-muted-foreground mt-1.5 text-sm leading-6">
                    {topic.description}
                  </p>
                  <p class="text-muted-foreground mt-3 text-xs">
                    {topic.count > 0 ? `${topic.count} 篇笔记` : "持续整理中"}
                  </p>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-3xl py-12 sm:py-16">
      <div
        class="border-border border-y py-10 sm:grid sm:grid-cols-[1fr_auto] sm:items-center sm:gap-10"
      >
        <div>
          <h2 class="font-display text-2xl font-semibold tracking-[-0.03em]">
            关于这个笔记本
          </h2>
          <p class="text-muted-foreground mt-3 max-w-xl text-sm leading-7">
            这里保留结果，也保留判断、失败与修正。它不是完成后的作品集，而是一份会慢慢生长的学习记录。
          </p>
        </div>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class="text-accent mt-6 inline-flex items-center gap-2 text-sm font-medium sm:mt-0"
        >
          了解更多 <IconArrowRight class="size-4" />
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
