---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";

const projects = [
  {
    name: "图神经网络检索研究",
    status: "进行中",
    summary: "围绕图表示学习、节点分类和检索任务，整理可复现实验与结果分析。",
    stack: ["GNN", "PyTorch", "Graph ML"],
    next: "补充实验配置、指标表和复盘文章。",
  },
  {
    name: "图 OOD 检测实验",
    status: "进行中",
    summary: "关注分布外检测、鲁棒性评估和不同图数据集上的泛化表现。",
    stack: ["OOD", "Robustness", "Python"],
    next: "沉淀数据集处理流程和失败案例。",
  },
  {
    name: "推荐系统与图推荐",
    status: "探索",
    summary: "记录推荐模型、图结构建模与实验 pipeline 的学习过程。",
    stack: ["Recommendation", "GNN", "Evaluation"],
    next: "把关键实验整理成系列文章。",
  },
  {
    name: "Python 数据科学笔记",
    status: "长期维护",
    summary: "从 NumPy、Pandas 到可视化和建模，积累可直接复用的代码片段。",
    stack: ["Python", "Pandas", "NumPy"],
    next: "补充更多真实数据处理案例。",
  },
];
---

<Layout title="项目 | jpf-hash's Blog" description="jpf-hash 的项目记录与实验方向">
  <Header />
  <Main
    pageTitle="项目"
    pageDesc="这里不是作品橱窗，而是实验、学习和复盘的路线图。"
  >
    <div class="grid gap-5 sm:grid-cols-2">
      {projects.map(project => (
        <article class="rounded-xl border border-card-border bg-card p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5">
          <div class="flex items-start justify-between gap-4">
            <h2 class="text-xl font-bold tracking-tight">{project.name}</h2>
            <span class="shrink-0 rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
              {project.status}
            </span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {project.summary}
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.stack.map(item => (
              <li class="rounded-full border border-card-border bg-background/60 px-2.5 py-1 text-xs text-muted-foreground">
                {item}
              </li>
            ))}
          </ul>
          <p class="mt-4 border-t border-card-border pt-4 text-sm text-muted-foreground">
            下一步：{project.next}
          </p>
        </article>
      ))}
    </div>
  </Main>
  <Footer />
</Layout>
