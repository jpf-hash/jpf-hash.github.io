---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const timeline = [
  {
    period: "01",
    title: "Programming Foundations",
    summary: "以 Python 为主要工具，建立清晰、可调试、可复用的代码习惯。",
    outputs: ["Python", "Data structures", "Files", "Debugging"],
  },
  {
    period: "02",
    title: "Tools & Workflow",
    summary: "整理 Git、命令行、编辑器、环境配置和写作流程，让日常学习更稳定。",
    outputs: ["Git", "CLI", "Editor", "Markdown"],
  },
  {
    period: "03",
    title: "Data Science Basics",
    summary:
      "围绕数据清洗、分析、可视化和记录方式，形成可以复用的数据处理流程。",
    outputs: ["NumPy", "Pandas", "Visualization", "Data notes"],
  },
  {
    period: "04",
    title: "Machine Learning Basics",
    summary: "学习经典模型、评估方法和实验过程，重点写清楚概念、代码和结果。",
    outputs: ["Models", "Evaluation", "Experiments", "Metrics"],
  },
  {
    period: "05",
    title: "Projects & Practice",
    summary: "把课程作业、小项目、部署过程和失败复盘写成以后能继续参考的记录。",
    outputs: ["Projects", "Deployment", "Debugging", "Postmortems"],
  },
  {
    period: "06",
    title: "Reading & Reflection",
    summary: "把技术文章、课程、书籍和论文阅读转化为自己的问题清单和理解记录。",
    outputs: ["Courses", "Books", "Papers", "Question lists"],
  },
];
---

<Layout
  title="Learning Timeline | jpf-hash 的笔记本"
  description="Python、数据、机器学习与项目实践的学习轨迹"
>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-5xl px-6 py-16 sm:py-20">
    <section class="max-w-3xl">
      <p class="text-accent text-xs font-semibold tracking-[0.22em] uppercase">
        Learning Timeline
      </p>
      <h1
        class="text-foreground mt-5 font-serif text-4xl leading-tight font-semibold text-balance sm:text-5xl"
      >
        From tools to practice.
      </h1>
      <p class="text-muted-foreground mt-6 max-w-2xl text-base leading-8">
        这不是一个完成后就停止的路线图，而是一条持续整理的学习轨迹：从工具能力到数据和机器学习基础，再到项目实践、阅读笔记和阶段复盘。
      </p>
    </section>

    <section class="border-card-border mt-14 border-y">
      {
        timeline.map(item => (
          <article class="border-card-border grid gap-5 border-b py-8 last:border-b-0 sm:grid-cols-[7rem_1fr] sm:gap-10">
            <div class="text-accent font-serif text-3xl">{item.period}</div>
            <div>
              <h2 class="text-foreground text-2xl font-semibold">
                {item.title}
              </h2>
              <p class="text-muted-foreground mt-3 max-w-2xl text-sm leading-7">
                {item.summary}
              </p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {item.outputs.map(output => (
                  <li class="border-card-border text-muted-foreground border px-3 py-1 text-xs font-medium tracking-[0.14em] uppercase">
                    {output}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </section>
  </main>
  <Footer />
</Layout>
