---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const timeline = [
  {
    period: "01",
    title: "Programming Foundations",
    summary: "以 Python 为主要工具，建立清晰、可调试、可复用的代码习惯。",
    outputs: ["Python", "Data structures", "Files", "Debugging"],
  },
  {
    period: "02",
    title: "Data Science Workflow",
    summary: "围绕数据清洗、分析、可视化和实验记录，形成稳定的数据处理流程。",
    outputs: ["NumPy", "Pandas", "Matplotlib", "Experiment logs"],
  },
  {
    period: "03",
    title: "Machine Learning Basics",
    summary: "理解经典模型的适用场景、评估方法和失败边界，而不是只记录公式。",
    outputs: ["KNN", "Decision trees", "Random forest", "Evaluation"],
  },
  {
    period: "04",
    title: "Deep Learning Practice",
    summary:
      "把模型训练拆成可观察、可复现的 pipeline，重视对照实验和训练细节。",
    outputs: ["PyTorch", "Training loops", "Ablations", "Reproducibility"],
  },
  {
    period: "05",
    title: "Graph Neural Networks",
    summary: "长期积累图表示学习、节点分类、OOD 检测和图推荐方向的研究笔记。",
    outputs: ["Graph learning", "Node classification", "OOD", "Recommendation"],
  },
  {
    period: "06",
    title: "Research Notes",
    summary: "将论文阅读、实验结果和项目复盘转化为可追踪的个人知识库。",
    outputs: ["Paper reading", "Result analysis", "Postmortems", "Next steps"],
  },
];
---

<Layout
  title="Learning Timeline | jpf-hash 的笔记本"
  description="Python、机器学习与图学习的学习轨迹"
>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-5xl px-6 py-16 sm:py-20">
    <section class="max-w-3xl">
      <p class="text-accent text-xs font-semibold tracking-[0.22em] uppercase">
        Learning Timeline
      </p>
      <h1
        class="text-foreground mt-5 font-serif text-4xl leading-tight font-semibold text-balance sm:text-5xl"
      >
        From tools to research notes.
      </h1>
      <p class="text-muted-foreground mt-6 max-w-2xl text-base leading-8">
        这不是一个完成后就停止的路线图，而是一条持续整理的学习轨迹：从工具能力到实验能力，再到围绕图学习和机器学习问题的长期记录。
      </p>
    </section>

    <section class="border-card-border mt-14 border-y">
      {
        timeline.map(item => (
          <article class="border-card-border grid gap-5 border-b py-8 last:border-b-0 sm:grid-cols-[7rem_1fr] sm:gap-10">
            <div class="text-accent font-serif text-3xl">{item.period}</div>
            <div>
              <h2 class="text-foreground text-2xl font-semibold">
                {item.title}
              </h2>
              <p class="text-muted-foreground mt-3 max-w-2xl text-sm leading-7">
                {item.summary}
              </p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {item.outputs.map(output => (
                  <li class="border-card-border text-muted-foreground border px-3 py-1 text-xs font-medium tracking-[0.14em] uppercase">
                    {output}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </section>
  </main>
  <Footer />
</Layout>
