---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";

const projects = getSortedPosts(await getCollection("posts")).filter(
  post => post.data.category === "项目"
);
---

<Layout
  title="作品 | jpf-hash"
  description="jpf-hash 的项目、实现过程与复盘记录。"
>
  <Header />
  <main id="main-content" class="app-layout pb-16">
    <section class="mx-auto max-w-3xl pt-20 pb-12 sm:pt-24 sm:pb-16">
      <p class="text-accent mb-3 text-sm font-medium">Selected work</p>
      <h1
        class="font-display max-w-3xl text-4xl leading-tight font-semibold tracking-[-0.045em] sm:text-6xl"
      >
        做过的项目，留下的过程。
      </h1>
      <p class="text-muted-foreground mt-5 max-w-2xl text-base leading-8">
        从问题、实现到结果和复盘。这里只展示已经公开的项目记录。
      </p>
    </section>

    {
      projects.length > 0 ? (
        <section class="mx-auto max-w-3xl">
          <ul class="space-y-2">
            {projects.map(project => (
              <Card variant="h2" {...project} />
            ))}
          </ul>
        </section>
      ) : (
        <div class="border-border bg-card mx-auto max-w-3xl rounded-2xl border p-6 text-sm shadow-sm">
          <p class="font-medium">项目页还在准备。</p>
          <p class="text-muted-foreground mt-2">
            当一项工作有了足够完整的问题、实现和复盘，它会出现在这里。
          </p>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>
