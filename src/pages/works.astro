---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";

const projects = getSortedPosts(await getCollection("posts")).filter(
  post => post.data.category === "项目"
);
---

<Layout
  title="作品 | jpf-hash"
  description="jpf-hash 的项目、实现过程与复盘记录。"
>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-border grid gap-8 border-b py-14 lg:grid-cols-[16rem_1fr] lg:py-20">
      <p class="text-accent text-xs font-bold uppercase">
        Work
      </p>
      <div>
        <h1 class="font-display max-w-4xl text-5xl leading-none font-semibold sm:text-7xl">
          做过的项目，留下的过程。
        </h1>
        <p class="text-muted-foreground mt-6 max-w-2xl text-lg leading-8">
          从问题、实现到结果和复盘。这里只展示已经公开的项目记录。
        </p>
      </div>
    </section>

    {
      projects.length > 0 ? (
        <section class="py-10 lg:py-14">
          <ul class="border-border border-t-2">
            {projects.map(project => <Card variant="h2" {...project} />)}
          </ul>
        </section>
      ) : (
        <p class="text-muted-foreground py-16 text-sm">目前没有公开项目。</p>
      )
    }
  </main>
  <Footer />
</Layout>
