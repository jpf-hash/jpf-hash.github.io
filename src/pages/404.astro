---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div
      class="border-border bg-card my-20 flex max-w-xl flex-col items-center justify-center rounded-3xl border px-8 py-14 text-center shadow-sm"
    >
      <span
        class="bg-accent/10 text-accent rounded-full px-3 py-1 text-sm font-medium"
        >Page not found</span
      >
      <h1 class="mt-6 text-8xl font-semibold tracking-[-0.08em]">404</h1>
      <p class="text-muted-foreground mt-4 text-xl">{t.notFound.message}</p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="bg-foreground text-background hover:bg-accent mt-8 rounded-xl px-4 py-2.5 text-sm font-medium no-underline"
      >
        {t.notFound.goHome}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
