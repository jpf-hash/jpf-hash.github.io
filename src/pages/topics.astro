---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const topics = [
  {
    id: "programming",
    title: "编程与工具",
    description: "Python、Git、命令行、开发环境，以及可以反复使用的工作流。",
  },
  {
    id: "data-ml",
    title: "数据与机器学习",
    description: "数据处理、模型评估、机器学习基础和实验过程。",
  },
  {
    id: "projects",
    title: "项目与实践",
    description: "从问题、实现到结果，记录项目真正经历过的过程。",
  },
  {
    id: "reading",
    title: "阅读笔记",
    description: "技术文章、书籍、课程和论文阅读中的理解与问题。",
  },
];

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const topicIds = new Set(topics.map(topic => topic.id));
const sections = topics.map(topic => ({
  ...topic,
  posts: posts.filter(post => post.data.topic === topic.id),
}));
const otherPosts = posts.filter(
  post => !post.data.topic || !topicIds.has(post.data.topic)
);

if (otherPosts.length > 0) {
  sections.push({
    id: "other",
    title: "其他记录",
    description: "尚未归入固定主题的站点记录、随笔和阶段性整理。",
    posts: otherPosts,
  });
}

const archiveLinks = [
  { label: "分类", href: getRelativeLocaleUrl(locale, "categories") },
  { label: "标签", href: getRelativeLocaleUrl(locale, "tags") },
  { label: "归档", href: getRelativeLocaleUrl(locale, "archives") },
];
---

<Layout
  title="主题 | jpf-hash"
  description="按编程、数据、项目和阅读主题整理的个人内容索引。"
>
  <Header />
  <main id="main-content" class="app-layout pb-16">
    <header class="mx-auto max-w-3xl pt-20 pb-12 sm:pt-24 sm:pb-16">
      <p class="text-accent mb-3 text-sm font-medium">Explore by topic</p>
      <h1
        class="font-display text-4xl leading-tight font-semibold tracking-[-0.045em] sm:text-6xl"
      >
        沿着主题，找到相关笔记。
      </h1>
      <p class="text-muted-foreground mt-5 max-w-2xl text-base leading-8">
        技术、项目、阅读和零散记录，会在理解逐渐清晰之后归入各自的路径。
      </p>

      <nav class="mt-8 flex flex-wrap gap-2" aria-label="主题快捷导航">
        {
          sections.map(section => (
            <a
              href={`#${section.id}`}
              class="border-border bg-card hover:border-accent hover:text-accent rounded-full border px-3 py-1.5 text-sm shadow-sm transition-colors"
            >
              {section.title}
            </a>
          ))
        }
      </nav>
    </header>

    <div class="mx-auto max-w-3xl space-y-5">
      {
        sections.map((section, index) => (
          <section
            id={section.id}
            class="border-border bg-card scroll-mt-28 rounded-2xl border p-5 shadow-sm sm:p-7"
          >
            <header class="flex items-start gap-4">
              <span class="bg-muted text-muted-foreground flex size-9 shrink-0 items-center justify-center rounded-lg font-mono text-xs">
                {(index + 1).toString().padStart(2, "0")}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h2 class="font-display text-xl font-semibold tracking-[-0.025em]">
                    {section.title}
                  </h2>
                  <span class="text-muted-foreground text-xs">
                    {section.posts.length} 篇
                  </span>
                </div>
                <p class="text-muted-foreground mt-2 text-sm leading-6">
                  {section.description}
                </p>
              </div>
            </header>

            {section.posts.length > 0 ? (
              <ul class="mt-6 space-y-2">
                {section.posts.map(post => (
                  <Card variant="h3" {...post} />
                ))}
              </ul>
            ) : (
              <p class="text-muted-foreground mt-6 border-t pt-5 text-sm">
                这里还没有公开笔记。
              </p>
            )}
          </section>
        ))
      }
    </div>

    <nav class="mx-auto mt-8 flex max-w-3xl flex-wrap gap-4 text-sm">
      {
        archiveLinks.map(link => (
          <a
            href={link.href}
            class="text-muted-foreground hover:text-accent transition-colors"
          >
            {link.label} ↗
          </a>
        ))
      }
    </nav>
  </main>
  <Footer />
</Layout>
