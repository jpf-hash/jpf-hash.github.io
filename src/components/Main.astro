---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-8", className]}
>
  <header class="border-border border-b pt-10 pb-10 sm:pt-14 sm:pb-14">
    <p class="text-accent text-xs font-bold uppercase">Archive</p>
    <h1 class="font-display mt-3 text-5xl leading-none font-semibold sm:text-7xl">{pageTitle}</h1>
    {pageDesc && <p class="text-muted-foreground mt-5 max-w-2xl text-base leading-7">{pageDesc}</p>}
  </header>
  <div class="pt-6">
    <slot />
  </div>
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
