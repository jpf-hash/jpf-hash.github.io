---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { getReadingTime } from "@/utils/getReadingTime";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, category, featured, tags, ...props } = data;
const readingTime = getReadingTime(body ?? "");
---

<li
  class="group border-card-border bg-card hover:border-accent/50 hover:shadow-accent/5 my-4 flex min-h-44 flex-col rounded-xl border p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
>
  <a href={getPostUrl(id, filePath, Astro.currentLocale)} class="block">
    <Heading
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="text-foreground group-hover:text-accent mb-3 inline-block text-lg font-bold tracking-tight transition-colors"
    >
      {title}
    </Heading>
  </a>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <span
      class="bg-accent/10 text-accent rounded-full px-2.5 py-1 text-xs font-semibold"
    >
      {category}
    </span>
    {
      featured && (
        <span class="border-accent/20 text-accent rounded-full border px-2.5 py-1 text-xs font-semibold">
          精选
        </span>
      )
    }
    {
      tags
        .slice(0, 2)
        .map(tag => (
          <span class="border-card-border text-muted-foreground rounded-full border px-2.5 py-1 text-xs">
            {tag}
          </span>
        ))
    }
  </div>
  <p class="text-muted-foreground line-clamp-2 text-sm leading-relaxed">
    {description}
  </p>
  <div class="mt-auto pt-4">
    <Datetime {...props} {readingTime} />
  </div>
</li>
