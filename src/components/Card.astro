---
import type { CollectionEntry } from "astro:content";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { postStatusLabels } from "@/utils/postStatus";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, description, category, featured, tags, status } = data;
const displayDate = data.modDatetime ?? data.pubDatetime;
const dateLabel = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(displayDate);
---

<li class="group">
  <article>
    <a
      href={getPostUrl(id, filePath, Astro.currentLocale)}
      class="border-border bg-card hover:bg-muted/70 grid gap-4 rounded-xl border p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md sm:grid-cols-[6rem_1fr_auto] sm:items-center sm:gap-5"
    >
      <div class="text-xs leading-5">
        <time
          class="text-muted-foreground font-mono"
          datetime={displayDate.toISOString()}
        >
          {dateLabel.slice(5)}
        </time>
        <p class="text-accent mt-1 font-medium">{category}</p>
      </div>

      <div>
        <Heading
          transition:name={slugifyStr(title.replaceAll(".", "-"))}
          class="font-display text-foreground group-hover:text-accent text-lg leading-snug font-semibold tracking-[-0.02em] transition-colors"
        >
          {title}
        </Heading>
        <p
          class="text-muted-foreground mt-1.5 line-clamp-2 max-w-2xl text-sm leading-6"
        >
          {description}
        </p>
        <p class="text-muted-foreground mt-2 text-xs">
          {postStatusLabels[status]}{featured ? " · 精选" : ""}{
            tags.length ? ` · ${tags.slice(0, 2).join(" / ")}` : ""
          }
        </p>
      </div>

      <span
        class="border-border text-muted-foreground group-hover:border-accent group-hover:text-accent hidden size-9 items-center justify-center rounded-lg border transition-all sm:flex"
      >
        <IconArrowRight
          class="size-4 transition-transform group-hover:translate-x-0.5"
        />
      </span>
    </a>
  </article>
</li>
