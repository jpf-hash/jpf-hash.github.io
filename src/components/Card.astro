---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { getReadingTime } from "@/utils/getReadingTime";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, category, featured, tags, ...props } = data;
const readingTime = getReadingTime(body ?? "");
---

<li
  class="group border-border hover:border-accent/50 grid gap-4 border-b py-7 transition-colors sm:grid-cols-[9rem_1fr]"
>
  <div class="text-muted-foreground text-xs leading-6 sm:pt-1">
    <div class="flex flex-wrap gap-2 sm:block">
      <span class="text-accent font-semibold">{category}</span>
      {featured && <span class="sm:mt-2 sm:block">精选</span>}
    </div>
    <div class="mt-2 hidden sm:block">
      <Datetime {...props} {readingTime} />
    </div>
  </div>

  <article>
    <a href={getPostUrl(id, filePath, Astro.currentLocale)} class="block">
      <Heading
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="text-foreground group-hover:text-accent text-xl font-semibold tracking-[-0.02em] transition-colors"
      >
        {title}
      </Heading>
    </a>
    <p class="text-muted-foreground mt-3 max-w-2xl text-sm leading-7">
      {description}
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        tags
          .slice(0, 3)
          .map(tag => (
            <span class="text-muted-foreground border-border border px-2 py-0.5 text-xs">
              {tag}
            </span>
          ))
      }
    </div>
    <div class="mt-4 sm:hidden">
      <Datetime {...props} {readingTime} />
    </div>
  </article>
</li>
