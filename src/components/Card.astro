---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { getReadingTime } from "@/utils/getReadingTime";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, category, featured, tags, ...props } = data;
const readingTime = getReadingTime(body ?? "");
---

<li
  class="group my-4 rounded-xl border border-card-border bg-card p-5 transition-all duration-300 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5 hover:-translate-y-0.5"
>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="block"
  >
    <Heading
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="text-accent mb-2 inline-block text-lg font-semibold tracking-tight group-hover:text-accent/80 transition-colors"
    >
      {title}
    </Heading>
  </a>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <span class="rounded-full bg-accent/10 px-2.5 py-1 text-xs font-semibold text-accent">
      {category}
    </span>
    {
      featured && (
        <span class="rounded-full border border-accent/20 px-2.5 py-1 text-xs font-semibold text-accent">
          精选
        </span>
      )
    }
    {tags.slice(0, 2).map(tag => (
      <span class="rounded-full border border-card-border px-2.5 py-1 text-xs text-muted-foreground">
        {tag}
      </span>
    ))}
  </div>
  <Datetime {...props} {readingTime} />
  <p class="text-muted-foreground mt-2 line-clamp-2 text-sm leading-relaxed">
    {description}
  </p>
</li>
